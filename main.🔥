# Import smtplib for the actual sending function
import smtplib

# Import the email modules we'll need
from email.message import EmailMessage

# Send the message via our own SMTP server.
s = smtplib.SMTP('https://mail.google.com')
msgs = s.getMessages()
msg = msgs[len(msgs)]
msg['Subject'] = "FWD MSG"
msg['From'] = guyann45@gmail.com
msg['To'] = guyann45@icloud.com
s.send_message(msg)
